{
  "manifest_version": 3,
  "name": "SkillHUD · Agent 技能抬头显示",
  "version": "1.0.0",
  "description": "贴在 Agent 网页边上的紧凑小面板，一目了然你装了哪些 Skill、怎么触发。打开即显示，用完折叠。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SkillHUD · 快捷键 Ctrl+Shift+H"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["skills.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
